   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "ejson value format\nEJ[1:<ephemeral pub b64>:<nonce b64>:<box b64>]\nNaCl box = Curve25519 + XSalsa20-Poly1305; one ephemeral\nkeypair per session, fresh 24-byte nonce per value.\n_-prefixed keys, numbers, bools, null stay plaintext.\nNative TS codec (tweetnacl), interop-tested against the\nGo CLI.",
   "originalText": "ejson value format\nEJ[1:<ephemeral pub b64>:<nonce b64>:<box b64>]\nNaCl box = Curve25519 + XSalsa20-Poly1305; one ephemeral\nkeypair per session, fresh 24-byte nonce per value.\n_-prefixed keys, numbers, bools, null stay plaintext.\nNative TS codec (tweetnacl), interop-tested against the\nGo CLI.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rect-0125",
   "lineHeight": 1.15,
   "autoResize": true,
   "customData": {
    "section": "B"
   }
  },
