   "seed": 1172852936,
   "version": 1,
   "versionNonce": 1931725976,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Every auth event, reveal, change, export, import, token use, membership change and rotation is appended. Secret values are never written to meta.",
   "originalText": "Every auth event, reveal, change, export, import, token use, membership change and rotation is appended. Secret values are never written to meta.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.15,
   "autoResize": true,
   "customData": {
    "section": "F"
   }
  },
