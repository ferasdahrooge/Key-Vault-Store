   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "Browser SPA: React 18 + Vite + TanStack\nQuery + Tailwind\n• served by Express from web/dist (same\n   origin, no CORS)\n• values masked by default; auto re-mask\n   + clipboard clear after 30 s\n• idle-lock overlay; red banner in\n   protected envs\n• x-csrf-token from GET /api/csrf\n• passkeys via @simplewebauthn/browser",
   "originalText": "Browser SPA: React 18 + Vite + TanStack\nQuery + Tailwind\n• served by Express from web/dist (same\n   origin, no CORS)\n• values masked by default; auto re-mask\n   + clipboard clear after 30 s\n• idle-lock overlay; red banner in\n   protected envs\n• x-csrf-token from GET /api/csrf\n• passkeys via @simplewebauthn/browser",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rect-0047",
   "lineHeight": 1.15,
   "autoResize": true,
   "customData": {
    "section": "A"
